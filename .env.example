# ─── مَـد — متغيّرات البيئة لـ Hetzner ─────────────────────────────────────────
# انسخ الملف: cp .env.example .env ثم عبّئ القيم. لا ترفع .env للمستودع.

# نطاق الموقع (يُستخدم في ALLOWED_ORIGINS و nginx)
DOMAIN=example.com

# Postgres (يفضّل Connection Pooling من Supabase — منفذ 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Supabase — مطلوبة وقت البناء والتشغيل
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# اختياري — إن وُجد يُفضَّل على SUPABASE_ANON_KEY في بناء الواجهة
# VITE_SUPABASE_ANON_KEY=your-anon-key

# بريد المدير (bootstrap) — مفصولة بفاصلة إن وُجد أكثر من واحد
ADMIN_EMAILS=you@example.com

# CORS — ضع رابط موقعك الكامل (بعد تفعيل HTTPS)
ALLOWED_ORIGINS=https://example.com

# المنفذ الداخلي للتطبيق (nginx يوجّه إليه)
PORT=8080

# اختياري: خرائط Google
# VITE_GOOGLE_MAPS_API_KEY=

# اختياري: الذكاء الاصطناعي
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_MODEL=

# ─── أتمتة دورة الطلب (شغّل أولاً بوضع الظل) ───────────────────────────────
AUTOMATION_ENABLED=true
AUTOMATION_MODE=shadow
AUTO_APPROVE_ENABLED=true
AUTO_ASSIGN_SUPPLIER_ENABLED=true
AUTO_ASSIGN_LOGISTICS_ENABLED=true
OFFER_TTL_MINUTES=30
CANDIDATE_CHAIN_CAP=5
MIN_CONFIDENCE_SCORE=0.35
TIE_MARGIN=0.05
DAILY_ORDER_CAP_PER_BUSINESS=20
