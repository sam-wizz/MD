[Unit]
Description=Madd (مَـد) API + frontend
After=network.target

[Service]
Type=simple
User=madd
Group=madd
WorkingDirectory=/opt/madd
EnvironmentFile=/opt/madd/.env
Environment=NODE_ENV=production
Environment=STATIC_DIR=/opt/madd/artifacts/erb-platform/dist/public
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/madd/artifacts/api-server/dist/index.mjs
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# أمان أساسي
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
